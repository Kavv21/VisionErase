# ── Application ───────────────────────────────────────────────
APP_ENV=development
APP_NAME=VisionErase
SECRET_KEY=change-me-in-production
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_TTL=86400
REDIS_JOB_DEDUP_TTL=3600

# ── Celery ─────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://visionerase:secret@postgres:5432/visionerase

# ── S3 / MinIO ─────────────────────────────────────────────────
S3_BUCKET=visionerase
S3_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── CV device & model pool ─────────────────────────────────────
DEVICE=cpu
MODEL_CACHE_DIR=/app/model_weights
MAX_MODEL_POOL_SIZE=2
MAX_VRAM_GB=4.0
USE_FP16=false

# ── Video pipeline ─────────────────────────────────────────────
CHUNK_DURATION_SEC=5
CHUNK_OVERLAP_FRAMES=2
MAX_VIDEO_DURATION_SEC=3600
MAX_VIDEO_SIZE_MB=2000

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Rate limiting ──────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=200

# ── Quality gates ──────────────────────────────────────────────
MIN_SSIM_SCORE=0.75
MIN_PSNR_DB=25.0

# ── Hierarchical pipeline ──────────────────────────────────────
NUM_SEGMENT_WORKERS=4
SEGMENT_OVERLAP_FRAMES=150
BOUNDARY_WINDOW_FRAMES=10
BOUNDARY_FUSION_ENABLED=true
BOUNDARY_FUSION_WEIGHTS=/app/model_weights/boundary_fusion.pt
